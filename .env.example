# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (get from the Neon dashboard — use the
# "pooled connection" / HTTP-compatible URL for @neondatabase/serverless).
DATABASE_URL="postgres://user:password@ep-example-12345.region.aws.neon.tech/dbname?sslmode=require"

# Auth.js — generate with: pnpm dlx auth secret
AUTH_SECRET=""

# Google OAuth — from Google Cloud Console → APIs & Services → Credentials →
# OAuth 2.0 Client ID (type "Web application"). Authorized redirect URI must
# be {origin}/api/auth/callback/google for every origin you sign in from
# (e.g. http://localhost:3000/api/auth/callback/google in dev).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Base URL of the deployed app. Left empty locally (Auth.js infers it from the
# request); on Vercel this is provided automatically via VERCEL_URL, so do NOT
# hardcode a custom domain here — the first deployments run on the default
# *.vercel.app URL, and root.house is connected later purely as a DNS step.
# AUTH_URL="https://your-preview-deployment.vercel.app"

# Vercel Blob (media storage) — from the Vercel dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=""

# Vercel Cron secret — the daily /api/cron/cleanup-uploads job (vercel.json)
# deletes uploaded-but-never-recorded files; Vercel sends it as a Bearer
# token. Any long random string, e.g. `openssl rand -hex 32`. Without it the
# job refuses to run.
CRON_SECRET=""

# Resend (invitation emails) — optional. Invitations work without it: the
# owner always gets a copyable invite link in the UI regardless of whether
# an email was actually sent (see src/lib/email/send-invitation.ts). Get a
# key from resend.com/api-keys. Until a custom domain is verified in Resend
# (Domains → Add Domain), use the no-setup sender below — it can only
# deliver to the email your Resend account is registered with, which is
# enough for local testing.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Root House <onboarding@resend.dev>"

# MapTiler (vector map tiles for /map) — from cloud.maptiler.com/account/keys.
# NEXT_PUBLIC_ because the key is used client-side by MapLibre GL JS in the
# browser (standard for MapTiler — abuse is controlled by quota/Origin
# restriction on the key itself, not by keeping it server-only). Restrict the
# key's Allowed HTTP Origins to your deployed domain once live.
NEXT_PUBLIC_MAPTILER_API_KEY=""

# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (get from the Neon dashboard — use the
# "pooled connection" / HTTP-compatible URL for @neondatabase/serverless).
DATABASE_URL="postgres://user:password@ep-example-12345.region.aws.neon.tech/dbname?sslmode=require"

# Auth.js — generate with: pnpm dlx auth secret
AUTH_SECRET=""

# Base URL of the deployed app. Left empty locally (Auth.js infers it from the
# request); on Vercel this is provided automatically via VERCEL_URL, so do NOT
# hardcode a custom domain here — the first deployments run on the default
# *.vercel.app URL, and root.house is connected later purely as a DNS step.
# AUTH_URL="https://your-preview-deployment.vercel.app"

# Vercel Blob (media storage) — from the Vercel dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=""
